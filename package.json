{
  "name": "rolnopol-test",
  "version": "1.0.0",
  "description": "Playwright test framework for RolnoPol website",
  "main": "index.js",
  "scripts": {
    "test": "npx playwright test",
    "test:local": "TEST_ENV=local npm test",
    "test:dev": "TEST_ENV=dev npm test",
    "test:uat": "TEST_ENV=uat npm test",
    "test:prod": "TEST_ENV=prod npm test",
    "report": "npx playwright show-report",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "lint:biome": "biome check .",
    "lint:biome:fix": "biome check . --apply",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1KarolG/rolnopol-test.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/1KarolG/rolnopol-test/issues"
  },
  "homepage": "https://github.com/1KarolG/rolnopol-test#readme",
  "devDependencies": {
    "@biomejs/biome": "^1.8.3",
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.6.2",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "dotenv": "^16.3.1",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-playwright": "^0.20.0",
    "prettier": "^3.2.5",
    "typescript": "^5.3.3"
  }
}
